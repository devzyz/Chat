{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "context": {
      "additionalProperties": false,
      "properties": {
        "buildInvocations": {
          "additionalProperties": false,
          "properties": {
            "ChatServer": {
              "const": 1
            },
            "GateServer": {
              "const": 1
            },
            "StatusServer": {
              "const": 1
            },
            "VarifyServer": {
              "const": 1
            },
            "chat-client": {
              "const": 1
            }
          },
          "required": [
            "GateServer",
            "StatusServer",
            "ChatServer",
            "chat-client",
            "VarifyServer"
          ],
          "type": "object"
        },
        "compatibility": {
          "enum": [
            "BOOTSTRAP_NO_PROMOTED_N_MINUS_1",
            "PASS"
          ]
        },
        "deploymentId": {
          "minimum": 1,
          "type": "integer"
        },
        "identity": {
          "additionalProperties": false,
          "properties": {
            "repository": {
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
              "type": "string"
            },
            "runAttempt": {
              "const": 1
            },
            "runId": {
              "minimum": 1,
              "type": "integer"
            },
            "sourceSha": {
              "pattern": "^[a-f0-9]{40}$",
              "type": "string"
            },
            "version": {
              "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:alpha|beta|rc)\\.[1-9][0-9]*)?$",
              "type": "string"
            },
            "workflowSha": {
              "pattern": "^[a-f0-9]{40}$",
              "type": "string"
            }
          },
          "required": [
            "version",
            "sourceSha",
            "runId",
            "runAttempt",
            "repository",
            "workflowSha"
          ],
          "type": "object"
        },
        "lockHashes": {
          "additionalProperties": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "required": [
            "vcpkg.json",
            "VarifyServer/package-lock.json"
          ],
          "type": "object"
        },
        "sourceTreeSha": {
          "pattern": "^[a-f0-9]{40}$",
          "type": "string"
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runnerImage",
            "visualStudio",
            "msbuild",
            "cmake",
            "ninja",
            "qt",
            "mingw",
            "node",
            "npm",
            "vcpkgBaseline",
            "vcpkgTriplet",
            "checkoutAction",
            "uploadAction",
            "qtAction",
            "nodeAction"
          ],
          "properties": {
            "runnerImage": {
              "const": "20260907.297.1"
            },
            "visualStudio": {
              "const": "17.14.37614.0"
            },
            "msbuild": {
              "const": "17.14.51+25f168cee"
            },
            "cmake": {
              "const": "cmake version 3.31.6"
            },
            "ninja": {
              "const": "1.13.2"
            },
            "qt": {
              "const": "6.5.3"
            },
            "mingw": {
              "const": "11.2.0"
            },
            "node": {
              "const": "v22.23.2"
            },
            "npm": {
              "const": "10.9.8"
            },
            "vcpkgBaseline": {
              "const": "fc3be1ebea7eaeb3071fe716ac65713af1f3a146"
            },
            "vcpkgTriplet": {
              "const": "x64-windows-chat-release"
            },
            "checkoutAction": {
              "const": "11bd71901bbe5b1630ceea73d27597364c9af683"
            },
            "uploadAction": {
              "const": "ea165f8d65b6e75b540449e92b4886f43607fa02"
            },
            "qtAction": {
              "const": "48d3ad6db93f3627c8ee7a0454bc6f3744f7e730"
            },
            "nodeAction": {
              "const": "49933ea5288caeca8642d1e84afbd3f7d6820020"
            }
          }
        },
        "upstream": {
          "additionalProperties": false,
          "properties": {
            "phase3c": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "phase3d": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "phase3c",
            "phase3d"
          ],
          "type": "object"
        }
      },
      "required": [
        "identity",
        "sourceTreeSha",
        "deploymentId",
        "lockHashes",
        "tools",
        "upstream",
        "compatibility",
        "buildInvocations"
      ],
      "type": "object"
    },
    "files": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "role": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "size": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "role",
          "size",
          "sha256"
        ],
        "type": "object"
      },
      "minProperties": 1,
      "type": "object"
    },
    "format": {
      "const": 1
    },
    "sbom": {
      "additionalProperties": false,
      "properties": {
        "policy": {
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "const": "CONTROLLED_DEPENDENCY_INVENTORY_FALLBACK"
        }
      },
      "required": [
        "status",
        "reason",
        "policy"
      ],
      "type": "object"
    }
  },
  "required": [
    "format",
    "context",
    "files",
    "sbom"
  ],
  "title": "release-manifest",
  "type": "object"
}
