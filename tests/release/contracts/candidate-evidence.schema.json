{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "minLength": 1,
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "expires_at": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "minimum": 1,
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "digest",
        "created_at",
        "expires_at"
      ],
      "type": "object"
    },
    "attestation": {
      "const": "UNAVAILABLE_NO_APPROVED_PINNED_GENERATOR"
    },
    "deploymentId": {
      "minimum": 1,
      "type": "integer"
    },
    "format": {
      "const": 1
    },
    "identity": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "type": "string"
        },
        "runAttempt": {
          "const": 1
        },
        "runId": {
          "minimum": 1,
          "type": "integer"
        },
        "sourceSha": {
          "pattern": "^[a-f0-9]{40}$",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:alpha|beta|rc)\\.[1-9][0-9]*)?$",
          "type": "string"
        },
        "workflowSha": {
          "pattern": "^[a-f0-9]{40}$",
          "type": "string"
        }
      },
      "required": [
        "version",
        "sourceSha",
        "runId",
        "runAttempt",
        "repository",
        "workflowSha"
      ],
      "type": "object"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "manifestSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "payloadName": {
          "minLength": 1,
          "type": "string"
        },
        "payloadSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "payloadSize": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "payloadSha256",
        "manifestSha256",
        "payloadSize",
        "payloadName"
      ],
      "type": "object"
    },
    "redownloadVerified": {
      "const": true
    },
    "retentionDays": {
      "const": 30
    }
  },
  "required": [
    "format",
    "identity",
    "deploymentId",
    "artifact",
    "payload",
    "retentionDays",
    "redownloadVerified",
    "attestation"
  ],
  "title": "candidate-evidence",
  "type": "object"
}
