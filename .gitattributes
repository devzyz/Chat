# Keep repository text deterministic and portable across Linux and Windows.
* text=auto eol=lf

# Windows command scripts require CRLF for maximum compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never apply text conversion to binary assets.
*.dll binary
*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary

# Pinned protoc output may contain a final blank line. Keep generated bytes
# reproducible while retaining all other whitespace checks.
generated/proto/cpp/** whitespace=-blank-at-eof
